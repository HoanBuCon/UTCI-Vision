# Sao chép thành .env (không commit): `make env`. Dùng chung cho Makefile, API, Vite, Docker Compose.
# Mọi tiến trình dùng cổng custom — KHÔNG dùng cổng mặc định 8000 / 8080 / 5173 / 8888 / 80.
# (Không ghi chú cuối dòng: Make và Python đọc nguyên giá trị.)

# FastAPI (trong Docker tự đặt host 0.0.0.0)
UTCI_API_HOST=127.0.0.1
UTCI_API_PORT=18100
# Nginx trong Docker — mở http://localhost:18080
UTCI_WEB_PORT=18080
# Vite dev server + vite preview
UTCI_DEV_PORT=15173
# JupyterLab (make jupyter)
UTCI_JUPYTER_PORT=18888
# Thiết bị khi chạy API local: cpu | 0 (GPU id)
UTCI_DEVICE=cpu
COMPOSE_PROJECT_NAME=utci
